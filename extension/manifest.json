{
  "manifest_version": 3,
  "name": "LogWithTempMail",
  "version": "1.0.0",
  "description": "A Extension to Log in to random websites with throw away emails",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}